{
  "config": {
    "step": {
      "user": {
        "description": "Log in at {account_url} with DevTools open, then paste the access token (short-lived) and the refresh token (valid ~6 months). The access token renews automatically; you only repeat this when the refresh token expires.\n\n",
        "data": {
          "access_token": "Access Token",
          "refresh_token": "Refresh Token"
        }
      },
      "reauth_confirm": {
        "description": "The Afore refresh token has expired. Log in again at {account_url} and paste a fresh access token and refresh token.",
        "data": {
          "access_token": "Access Token",
          "refresh_token": "Refresh Token"
        }
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
      "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]"
    }
  },
  "entity": {
    "sensor": {
      "generation_power": {
        "name": "Current Energy Generation"
      },
      "generation_total": {
        "name": "Total Energy Generation"
      },
      "generation_year": {
        "name": "This Year Energy Generation"
      },
      "generation_month": {
        "name": "This Month Energy Generation"
      },
      "generation_value": {
        "name": "Today's Energy Generation"
      }
    }
  }
}
